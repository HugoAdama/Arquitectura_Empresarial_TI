---
import { courseNavigation } from '../data/course-navigation';
---
<aside class="sidebar" aria-label="Navegación de la guía">
      <p class="sidebar-label">Mapa de capítulos</p>
        <details class="mobile-menu">
          <summary><span>Explorar la guía</span><span class="mobile-current" id="mobile-current">Tema 1 · Fundamentos</span></summary>
          <nav aria-label="Secciones del curso en móvil">
            {courseNavigation.map((item) => <a href={`#${item.id}`}>{item.sidebarLabel}</a>)}
          </nav>
        </details>
        <nav class="desktop-nav" aria-label="Secciones del curso">
          {courseNavigation.map((item) => <a href={`#${item.id}`}>{item.sidebarLabel}</a>)}
        </nav>
        <div class="sidebar-tip">
          <span class="tip-icon" aria-hidden="true">↗</span>
          <p>Idea para recordar</p>
          <strong>Primero entiende la organización; después decide qué tecnología necesita.</strong>
        </div>
      </aside>
