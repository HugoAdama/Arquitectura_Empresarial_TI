---
import '../styles/global.css';
import '../styles/learning.css';
interface Props { title?: string; description?: string; }
const { title = 'Atlas de Arquitectura Empresarial de TI', description = 'Atlas editorial de estudio para conectar estrategia, procesos, datos y tecnología en siete capítulos.' } = Astro.props;
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#f2efe6" /><link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap" /><title>{title}</title></head><body><slot /><script>import '../scripts/course';</script></body></html>
